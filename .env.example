# ============================================================
# CONFIGURACIÓN DE FIREBASE — CONTROL DE OBRAS
# Instrucciones: Copia este archivo como .env.local y completa
# tus credenciales reales obtenidas de console.firebase.google.com
# ============================================================

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# ============================================================
# INTEGRACIÓN OPCIONAL CON GOOGLE DRIVE & APPS SCRIPT
# ============================================================
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=tu_folder_id_opcional
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/tu_script_id/exec
VITE_DRIVE_WEBHOOK_SECRET=tu_webhook_secret_opcional
